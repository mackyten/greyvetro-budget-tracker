<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout for the home-screen net worth widget — plain Android
     resources only, since RemoteViews can't reuse lib/core/design_tokens.dart. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/net_worth_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="#FFFFFFFF"
    android:padding="12dp">

    <TextView
        android:id="@+id/net_worth_widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Net Worth"
        android:textSize="11sp"
        android:textColor="#8A93A0"
        tools:text="Net Worth" />

    <TextView
        android:id="@+id/net_worth_widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#2E343D"
        tools:text="₱120,000.00" />

    <TextView
        android:id="@+id/net_worth_widget_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#8A93A0"
        tools:text="As of January 2026" />
</LinearLayout>
