<?xml version="1.0" encoding="utf-8"?>
<!-- Tells R8's resource shrinker to keep resources that are only ever
     referenced by string name at runtime (e.g. flutter_local_notifications'
     `AndroidInitializationSettings('ic_notification')`), which its static
     usage analysis can't see and would otherwise strip from release builds.
     See https://developer.android.com/build/shrink-code#keep-resources. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification" />
