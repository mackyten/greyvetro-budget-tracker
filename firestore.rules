rules_version = '2';

// Real per-user rules (TASK-001). Signed-in users authenticate directly
// against Firebase Auth (Google Sign-In) today — see
// lib/core/auth/firebase_google_auth_service.dart. When greyvetro-auth-hub
// (Keycloak) is bridged in later, signed-in users will still be Firebase
// Auth users (via a minted custom token instead of Google), so
// `request.auth.uid` and these rules don't need to change — only the sign-in
// flow does.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // TEMPORARY: pre-auth data written before per-user scoping existed (see
    // lib/features/net_worth/data/legacy_data_migrator.dart), read-only to
    // any signed-in user so the one-time migration can still read it once.
    // Delete this block once `users/{uid}/accounts` in the console confirms
    // migration ran.
    match /accounts/{document} {
      allow read: if request.auth != null;
    }
    match /monthlyEntries/{document} {
      allow read: if request.auth != null;
    }
  }
}
